QMainWindow, QWidget {
    background: @BACKGROUND@;
    color: @TEXT@;
    font-family: @SANS_FONT@;
    font-size: 13px;
}
QLabel {
    background: transparent;
}
QLabel#heroTitle {
    color: @BRIGHT@;
    font-size: 42px;
    font-weight: 700;
}
QLabel#heroSubtitle, QLabel[muted="true"] {
    color: @MUTED@;
}
QLabel#sceneTitle {
    color: @BRIGHT@;
    font-size: 24px;
    font-weight: 700;
}
QLabel[heading="true"] {
    color: @BRIGHT@;
    font-size: 15px;
    font-weight: 650;
}
QLabel[metric="true"] {
    color: @CYAN@;
    font-family: @MONO_FONT@;
    font-size: 30px;
    font-weight: 700;
}
QLabel[metricSmall="true"] {
    color: @CYAN@;
    font-family: @MONO_FONT@;
    font-size: 16px;
    font-weight: 650;
}
QLabel[mono="true"] {
    font-family: @MONO_FONT@;
}
QLabel[accent="true"] {
    color: @CYAN@;
    font-family: @MONO_FONT@;
    font-weight: 650;
}
QLabel[warning="true"] {
    color: @AMBER@;
}
QLabel[statusFail="true"] {
    color: @RED@;
    font-family: @MONO_FONT@;
    font-weight: 700;
}
QLabel[statusPass="true"] {
    color: @GREEN@;
    font-family: @MONO_FONT@;
    font-weight: 700;
}
QFrame[panel="true"], QFrame[gateFailed="true"] {
    background: rgba(14, 20, 32, 225);
    border: 1px solid @GRID@;
    border-radius: 6px;
}
QFrame[gateFailed="true"] {
    border-color: @RED@;
}
QFrame#navigationRail {
    background: @RAIL@;
    border-right: 1px solid @GRID@;
}
QFrame#orbitToolbar, QFrame#playbackControls {
    background: @RAIL@;
    border-bottom: 1px solid @GRID@;
}
QLabel#encounterIdentity {
    background: @PANEL@;
    border-bottom: 1px solid @GRID@;
    color: @TEXT@;
    font-size: 12px;
}
QFrame#playbackControls {
    border-top: 1px solid @GRID@;
    border-bottom: 0;
}
QLabel#brand {
    color: @BRIGHT@;
    font-size: 18px;
    font-weight: 750;
}
QPushButton {
    background: @PANEL_ALT@;
    border: 1px solid @BORDER@;
    border-radius: 5px;
    color: @TEXT@;
    padding: 7px 12px;
}
QPushButton[primary="true"] {
    background: @PRIMARY_BUTTON@;
    border-color: @CYAN@;
    color: @BRIGHT@;
    font-weight: 650;
    padding: 10px 18px;
}
QPushButton:hover {
    border-color: @CYAN@;
    color: @BRIGHT@;
}
QPushButton:checked {
    background: @CHECKED_BUTTON@;
    border-color: @CYAN@;
}
QSlider::groove:horizontal {
    height: 4px;
    background: @GRID@;
}
QSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
    background: @CYAN@;
}
QComboBox {
    background: @PANEL_ALT@;
    border: 1px solid @BORDER@;
    border-radius: 5px;
    color: @TEXT@;
    padding: 6px 9px;
}
QComboBox QAbstractItemView {
    background: @PANEL_ALT@;
    border: 1px solid @BORDER@;
    selection-background-color: @CHECKED_BUTTON@;
}
QTableWidget {
    background: @PANEL@;
    alternate-background-color: @PANEL_ALT@;
    border: 1px solid @GRID@;
    gridline-color: @GRID@;
}
QHeaderView::section {
    background: @PANEL_ALT@;
    color: @TEXT@;
    border: 0;
    padding: 6px;
}
QScrollBar:vertical {
    background: @RAIL@;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: @BORDER@;
    min-height: 28px;
    border-radius: 4px;
}
